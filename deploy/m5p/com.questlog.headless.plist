<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.questlog.headless</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/power/questlog-bin/questlog-headless</string>
        <string>--serve</string>
        <string>--bind</string>
        <string>127.0.0.1:5889</string>
    </array>
    <!-- launchd 默认 PATH 不含 Homebrew——执行器探测序/CLI spawn 全靠这里 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>RUST_LOG</key>
        <string>info</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/power/questlog-runtime/logs/headless-launchd.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/power/questlog-runtime/logs/headless-launchd.err</string>
</dict>
</plist>
